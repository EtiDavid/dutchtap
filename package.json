{
  "name": "dutchtap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audio:sample": "node scripts/generate-flashcard-audio.mjs",
    "audio:all": "node scripts/generate-flashcard-audio.mjs --all",
    "audio:voices": "node scripts/generate-flashcard-audio.mjs --voices",
    "audio:check": "node scripts/generate-flashcard-audio.mjs --all --dry-run",
    "assets:words": "node scripts/word-assets.mjs",
    "assets:flashcards": "node scripts/check-flashcard-assets.mjs",
    "test:flashcards": "playwright test --config playwright.flashcards.config.ts",
    "test:prod": "playwright test --config playwright.prod.config.ts",
    "test:sessions-db": "TEST_MONGODB_URI=mongodb://127.0.0.1:27018 vitest run tests/sessions.mongo.test.ts",
    "content:workplace": "python3 scripts/assemble-workplace.py --check",
    "content:learning-words": "node scripts/sync-learning-vocabulary.mjs",
    "content:learning-check": "node scripts/sync-learning-vocabulary.mjs --check",
    "audio:generate:dry-run": "node scripts/generate-learning-audio.mjs",
    "audio:install:dry-run": "node scripts/install-learning-audio.mjs",
    "audio:install": "node scripts/install-learning-audio.mjs --apply",
    "audio:generate": "node scripts/generate-learning-audio.mjs --apply",
    "audio:export": "node scripts/export-learning-audio.mjs",
    "audio:workplace500:review": "node scripts/export-workplace-500-review.mjs",
    "audio:workplace500:manifest": "node scripts/export-approved-workplace-500.mjs",
    "audio:workplace500:full": "node scripts/run-workplace-500.mjs",
    "audio:workplace500:finalize": "node scripts/finalize-workplace-500.mjs",
    "content:audit": "node scripts/audit-learning-content.mjs",
    "content:review-check": "node scripts/audit-learning-content.mjs --require-complete",
    "grammar:release-gate": "node scripts/check-grammar-acceptance.mjs",
    "grammar:recount": "node scripts/grammar-recount.mjs --check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
