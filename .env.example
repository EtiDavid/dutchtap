# MongoDB Atlas connection string (include a database name, e.g. .../dutchtap?...)
MONGODB_URI=

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local audio generation only — never expose these as NEXT_PUBLIC variables.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
